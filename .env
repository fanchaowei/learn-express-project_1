# 数据库连接配置（从 docker/.env 复制这些值）
DB_HOST=localhost
DB_PORT=5433
DB_NAME=myapp_db
DB_USER=postgres
DB_PASSWORD=postgres123

# 服务器配置
PORT=3000
NODE_ENV=development


# Prisma 数据库连接配置
# 【核心概念】DATABASE_URL 格式
# - 格式：postgresql://用户名:密码@主机:端口/数据库名
# - 对比原生 pg：原生 pg 使用分离的配置项，Prisma 使用连接字符串
DATABASE_URL="postgresql://postgres:postgres123@localhost:5433/myapp_db"